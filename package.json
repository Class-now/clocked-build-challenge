{
  "name": "gatehouse",
  "version": "0.1.0",
  "private": true,
  "description": "A checkpoint between an AI agent and the real world, built on the Clocked APIs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "record": "tsx scripts/record.ts",
    "gatehouse": "tsx src/cli/gatehouse.ts",
    "demo": "tsx src/cli/gatehouse.ts demo",
    "eval": "tsx eval/run.ts",
    "dev": "vite --config web/vite.config.ts",
    "dev:fake": "vite --config web/vite.config.ts --mode fake",
    "build:web": "tsx scripts/index-recordings.ts && vite build --config web/vite.config.ts",
    "postrecord": "tsx scripts/index-recordings.ts",
    "recordings:index": "tsx scripts/index-recordings.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/big-shoulders-stencil": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15"
  },
  "bin": {
    "gatehouse": "src/cli/bin.mjs"
  }
}
